# Copy to frontend/.env.local for the local Vite development server.
# These are public API addresses. Never put Firebase Admin or Azure secrets here.
VITE_AUTH_SERVICE_URL=http://localhost:8001
VITE_USER_SERVICE_URL=http://localhost:8002
VITE_BOOK_SERVICE_URL=http://localhost:8003
VITE_TRANSLATION_SERVICE_URL=http://localhost:8004
