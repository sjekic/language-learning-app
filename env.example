# Copy to root .env for Docker Compose. Existing shell variables take precedence.
# .env and .env.local are gitignored. Compose does not load .env.local automatically.
# Frontend API URLs belong in frontend/.env.local; see frontend/.env.example.

# Native Python services only; Compose supplies its own internal database URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/language_learning

# Firebase Admin is required to verify sign-in tokens. Compose forwards this JSON
# value to auth-service. Leave empty for service startup without working API auth.
# Set it in your shell from a service account file (see README), or use single-quoted
# JSON here, preserving the private key's escaped newlines. Never use a VITE_ prefix.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Native Python services also support an absolute path to the service account JSON.
# Compose does not mount host files or forward this path.
# FIREBASE_SERVICE_ACCOUNT_PATH=

# Local book-service startup skips Azure by default. DEV_MODE does not generate a
# completed story: it returns an ID and status remains processing.
DEV_MODE=true

# Azure configuration for an existing cloud-backed generation pipeline.
# Set DEV_MODE=false only after storage and the external job workers are configured.
# Compose does not create Azure resources or run the workers under jobs/.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=westeurope
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=book-content
AZURE_STORAGE_COVER_CONTAINER=book-covers

# Optional native Bash launcher overrides (scripts/dev-fullstack.sh).
# AUTH_SERVICE_PORT=8001
# USER_SERVICE_PORT=8002
# BOOK_SERVICE_PORT=8003
# TRANSLATION_SERVICE_PORT=8004
# FRONTEND_PORT=5173
# AUTH_SERVICE_URL=http://localhost:8001


